{
  "name": "aimyear-mcp",
  "version": "0.2.0",
  "description": "AimYear MCP server: one measurable yearly goal, a path of steps, focus sessions with attention shares, and a stop rule for comfortable work.",
  "type": "module",
  "bin": {
    "aimyear-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:conformance": "tsx test/conformance.ts",
    "test:oauth": "tsx test/oauth-e2e.ts",
    "access-doc": "tsx scripts/access-doc.ts",
    "surface-lock": "tsx scripts/surface-lock.ts"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "firebase-admin": "^14.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
